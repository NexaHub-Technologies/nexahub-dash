# The dashboard's server. Locally these come from a Neon dev branch:
#   neon checkout dev --create   (writes DATABASE_URL and NEON_AUTH_BASE_URL)
# DATABASE_URL must be the pooled string for the dash_app role, never the owner.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Migrations and type generation run as the owner. Local Docker:
#   postgres://postgres:postgres@127.0.0.1:54322/nexahub
DATABASE_OWNER_URL=

# End-to-end tests sign in as this admin (scripts/bootstrap-admin.ts makes it)
E2E_ADMIN_EMAIL=admin@nexahub.test
E2E_ADMIN_PASSWORD=

# Coursework files (assessment briefs and students' submissions) live in Neon
# Object Storage, in the private bucket "coursework" that neon.ts declares.
#   neon env pull   (writes these four for the checked-out branch)
# then once per branch, to let browsers upload straight to the bucket:
#   bun scripts/storage-setup.ts
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
